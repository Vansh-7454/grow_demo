# Environment variables template for Paws & Claws Pet Grooming (Gurugram)
# Copy this file to .env.local to customize local deployment values

# Production base URL for sitemap, canonical links, and Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://pawsandclaws-gurugram.vercel.app

# Google Maps & Business Profile integration
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_ID=
NEXT_PUBLIC_GOOGLE_REVIEW_LINK=

# Studio WhatsApp and Phone Configuration
NEXT_PUBLIC_WHATSAPP_NUMBER=919876500000
NEXT_PUBLIC_STUDIO_PHONE=+919876500000
